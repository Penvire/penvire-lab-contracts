{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "initial-version": "0.1.0",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "packages": {
    "openapi/identity": {
      "component": "openapi-identity",
      "extra-files": [
        {
          "type": "yaml",
          "path": "openapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    },
    "openapi/tenant": {
      "component": "openapi-tenant",
      "extra-files": [
        {
          "type": "yaml",
          "path": "openapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    },
    "openapi/engagement": {
      "component": "openapi-engagement",
      "extra-files": [
        {
          "type": "yaml",
          "path": "openapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    },
    "openapi/evidence": {
      "component": "openapi-evidence",
      "extra-files": [
        {
          "type": "yaml",
          "path": "openapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    },
    "openapi/audit": {
      "component": "openapi-audit",
      "extra-files": [
        {
          "type": "yaml",
          "path": "openapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    },
    "openapi/bff": {
      "component": "openapi-bff",
      "extra-files": [
        {
          "type": "yaml",
          "path": "openapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    },
    "asyncapi/identity": {
      "component": "asyncapi-identity",
      "extra-files": [
        {
          "type": "yaml",
          "path": "asyncapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    }
  }
}
